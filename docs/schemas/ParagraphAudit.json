{
  "$defs": {
    "AuditedAtom": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "anchor": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Anchor",
          "type": "string"
        },
        "kind": {
          "enum": [
            "fact",
            "inference",
            "recommendation",
            "example"
          ],
          "title": "Kind",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "entailment",
            "contradiction",
            "insufficient"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "answered_criterion_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Answered Criterion Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "anchor",
        "kind",
        "claim_ids",
        "evidence_ids",
        "verdict",
        "answered_criterion_ids"
      ],
      "title": "AuditedAtom",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "paragraph_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Paragraph Id",
      "type": "string"
    },
    "atoms": {
      "items": {
        "$ref": "#/$defs/AuditedAtom"
      },
      "title": "Atoms",
      "type": "array"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "headings_supported": {
      "title": "Headings Supported",
      "type": "boolean"
    },
    "unsupported_text": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Unsupported Text",
      "type": "array"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    }
  },
  "required": [
    "paragraph_id",
    "atoms",
    "complete",
    "headings_supported",
    "unsupported_text",
    "explanation"
  ],
  "title": "ParagraphAudit",
  "type": "object"
}
