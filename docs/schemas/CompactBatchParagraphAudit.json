{
  "$defs": {
    "CompactAuditedAtom": {
      "additionalProperties": false,
      "description": "The exact anchor already contains the prose; do not paraphrase it again.",
      "properties": {
        "anchor": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Anchor",
          "type": "string"
        },
        "kind": {
          "enum": [
            "fact",
            "inference",
            "recommendation",
            "example"
          ],
          "title": "Kind",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "entailment",
            "contradiction",
            "insufficient"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "answered_criterion_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Answered Criterion Ids",
          "type": "array"
        }
      },
      "required": [
        "anchor",
        "kind",
        "claim_ids",
        "evidence_ids",
        "verdict",
        "answered_criterion_ids"
      ],
      "title": "CompactAuditedAtom",
      "type": "object"
    },
    "CompactParagraphAudit": {
      "additionalProperties": false,
      "properties": {
        "paragraph_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Paragraph Id",
          "type": "string"
        },
        "atoms": {
          "items": {
            "$ref": "#/$defs/CompactAuditedAtom"
          },
          "title": "Atoms",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "headings_supported": {
          "title": "Headings Supported",
          "type": "boolean"
        },
        "unsupported_text": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Unsupported Text",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "paragraph_id",
        "atoms",
        "complete",
        "headings_supported",
        "unsupported_text",
        "explanation"
      ],
      "title": "CompactParagraphAudit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "paragraphs": {
      "items": {
        "$ref": "#/$defs/CompactParagraphAudit"
      },
      "title": "Paragraphs",
      "type": "array"
    }
  },
  "required": [
    "paragraphs"
  ],
  "title": "CompactBatchParagraphAudit",
  "type": "object"
}
