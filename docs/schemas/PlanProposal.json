{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Criterion Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "authoritative_fact",
            "corroborated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "facet_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Facet Ids",
          "type": "array"
        }
      },
      "required": [
        "criterion_id",
        "description",
        "kind"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "TaskProposal": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Question",
          "type": "string"
        },
        "facet_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Facet Ids",
          "type": "array"
        },
        "priority": {
          "maximum": 3,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "scope": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scope",
          "type": "string"
        },
        "exclusions": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "seed_queries": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Seed Queries",
          "type": "array"
        },
        "source_targets": {
          "items": {
            "enum": [
              "official",
              "paper",
              "repository",
              "independent",
              "discussion",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Source Targets",
          "type": "array"
        },
        "source_urls": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Source Urls",
          "type": "array"
        },
        "success_criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        },
        "parent_gap_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Parent Gap Ids",
          "type": "array"
        }
      },
      "required": [
        "question",
        "facet_ids",
        "priority",
        "scope",
        "exclusions",
        "seed_queries",
        "source_targets",
        "success_criteria",
        "parent_gap_ids"
      ],
      "title": "TaskProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outline": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Outline",
      "type": "array"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/TaskProposal"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    },
    "validation_note": {
      "title": "Validation Note",
      "type": "string"
    }
  },
  "required": [
    "outline",
    "tasks",
    "validation_note"
  ],
  "title": "PlanProposal",
  "type": "object"
}
