{
  "$defs": {
    "ReportSection": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Heading",
          "type": "string"
        },
        "statements": {
          "items": {
            "$ref": "#/$defs/ReportStatement"
          },
          "title": "Statements",
          "type": "array"
        }
      },
      "required": [
        "heading",
        "statements"
      ],
      "title": "ReportSection",
      "type": "object"
    },
    "ReportStatement": {
      "additionalProperties": false,
      "properties": {
        "statement_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Statement Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "fact",
            "inference",
            "recommendation",
            "limitation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "statement_id",
        "text",
        "kind",
        "claim_ids",
        "evidence_ids"
      ],
      "title": "ReportStatement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ReportSection"
      },
      "title": "Sections",
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "unresolved_questions": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "title",
    "sections",
    "limitations",
    "unresolved_questions"
  ],
  "title": "ReportDraft",
  "type": "object"
}
