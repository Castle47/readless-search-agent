{
  "$defs": {
    "ComposedParagraph": {
      "additionalProperties": false,
      "properties": {
        "block_type": {
          "enum": [
            "paragraph",
            "list",
            "table",
            "code"
          ],
          "title": "Block Type",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Language"
        },
        "illustrative": {
          "title": "Illustrative",
          "type": "boolean"
        },
        "claim_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "block_type",
        "text",
        "language",
        "illustrative",
        "claim_ids",
        "evidence_ids"
      ],
      "title": "ComposedParagraph",
      "type": "object"
    },
    "ComposedSection": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "title": "Heading",
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/ComposedParagraph"
          },
          "minItems": 1,
          "title": "Paragraphs",
          "type": "array"
        }
      },
      "required": [
        "heading",
        "paragraphs"
      ],
      "title": "ComposedSection",
      "type": "object"
    },
    "UnresolvedEditorialIssue": {
      "additionalProperties": false,
      "properties": {
        "feedback_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Feedback Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "feedback_id",
        "description"
      ],
      "title": "UnresolvedEditorialIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ComposedSection"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "addressed_feedback_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Addressed Feedback Ids",
      "type": "array"
    },
    "remaining_issues": {
      "items": {
        "$ref": "#/$defs/UnresolvedEditorialIssue"
      },
      "title": "Remaining Issues",
      "type": "array"
    }
  },
  "required": [
    "title",
    "sections",
    "addressed_feedback_ids",
    "remaining_issues"
  ],
  "title": "EditorialRevision",
  "type": "object"
}
