{
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source Id",
      "type": "string"
    },
    "chunk_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Chunk Id",
      "type": "string"
    },
    "quote": {
      "maxLength": 1200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Quote",
      "type": "string"
    },
    "start_char": {
      "minimum": 0,
      "title": "Start Char",
      "type": "integer"
    },
    "end_char": {
      "exclusiveMinimum": 0,
      "title": "End Char",
      "type": "integer"
    },
    "claim_text": {
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Claim Text",
      "type": "string"
    },
    "relation": {
      "enum": [
        "supports",
        "contradicts"
      ],
      "title": "Relation",
      "type": "string"
    },
    "criterion_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Criterion Ids",
      "type": "array"
    },
    "temporal_scope": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Temporal Scope"
    },
    "directness": {
      "enum": [
        "direct",
        "indirect"
      ],
      "title": "Directness",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "chunk_id",
    "quote",
    "start_char",
    "end_char",
    "claim_text",
    "relation",
    "criterion_ids",
    "temporal_scope",
    "directness"
  ],
  "title": "EvidenceCandidate",
  "type": "object"
}
