{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "criterion_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Criterion Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "authoritative_fact",
            "corroborated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "facet_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Facet Ids",
          "type": "array"
        }
      },
      "required": [
        "required",
        "criterion_id",
        "description",
        "kind",
        "facet_ids"
      ],
      "title": "Criterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "question": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Question",
      "type": "string"
    },
    "facet_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Facet Ids",
      "type": "array"
    },
    "priority": {
      "maximum": 3,
      "minimum": 1,
      "title": "Priority",
      "type": "integer"
    },
    "scope": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Scope",
      "type": "string"
    },
    "exclusions": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "seed_queries": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Seed Queries",
      "type": "array"
    },
    "source_targets": {
      "items": {
        "enum": [
          "official",
          "paper",
          "repository",
          "independent",
          "discussion",
          "unknown"
        ],
        "type": "string"
      },
      "title": "Source Targets",
      "type": "array"
    },
    "source_urls": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Source Urls",
      "type": "array"
    },
    "success_criteria": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Success Criteria",
      "type": "array"
    },
    "parent_gap_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Parent Gap Ids",
      "type": "array"
    },
    "task_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Task Id",
      "type": "string"
    },
    "max_rounds": {
      "maximum": 3,
      "minimum": 1,
      "title": "Max Rounds",
      "type": "integer"
    }
  },
  "required": [
    "question",
    "facet_ids",
    "priority",
    "scope",
    "exclusions",
    "seed_queries",
    "source_targets",
    "source_urls",
    "success_criteria",
    "parent_gap_ids",
    "task_id",
    "max_rounds"
  ],
  "title": "ResearchTask",
  "type": "object"
}
