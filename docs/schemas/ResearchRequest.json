{
  "$defs": {
    "RequestLimits": {
      "additionalProperties": false,
      "properties": {
        "search_calls": {
          "anyOf": [
            {
              "maximum": 16,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Search Calls"
        },
        "fetched_pages": {
          "anyOf": [
            {
              "maximum": 30,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fetched Pages"
        },
        "total_tokens": {
          "anyOf": [
            {
              "maximum": 400000,
              "minimum": 12000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Tokens"
        },
        "wall_seconds": {
          "anyOf": [
            {
              "maximum": 1200,
              "minimum": 30,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wall Seconds"
        }
      },
      "title": "RequestLimits",
      "type": "object",
      "required": [
        "search_calls",
        "fetched_pages",
        "total_tokens",
        "wall_seconds"
      ]
    },
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        }
      },
      "title": "TimeRange",
      "type": "object",
      "required": [
        "start",
        "end"
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "query": {
      "maxLength": 8000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Query",
      "type": "string"
    },
    "context": {
      "maxLength": 12000,
      "title": "Context",
      "type": "string"
    },
    "output_language": {
      "enum": [
        "zh-CN",
        "en"
      ],
      "title": "Output Language",
      "type": "string"
    },
    "as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "As Of"
    },
    "time_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed_domains": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 30,
      "title": "Allowed Domains",
      "type": "array"
    },
    "blocked_domains": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 30,
      "title": "Blocked Domains",
      "type": "array"
    },
    "memory_mode": {
      "enum": [
        "read_write",
        "read_only",
        "off"
      ],
      "title": "Memory Mode",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/RequestLimits"
    }
  },
  "required": [
    "schema_version",
    "query",
    "context",
    "output_language",
    "as_of",
    "time_range",
    "allowed_domains",
    "blocked_domains",
    "memory_mode",
    "limits"
  ],
  "title": "ResearchRequest",
  "type": "object"
}
