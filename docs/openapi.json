  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "citation_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Citation Id"
          },
          "statement_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Statement Id"
          },
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Claim Id"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Evidence Id"
          },
          "ordinal": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Ordinal"
          },
          "paragraph_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paragraph Id"
          },
          "start_char": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Char"
          },
          "end_char": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Char"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "citation_id",
          "statement_id",
          "claim_id",
          "evidence_id",
          "ordinal"
        ],
        "title": "Citation"
      },
      "ExecutionSummary": {
        "properties": {
          "model_id": {
            "type": "string",
            "enum": [
              "openai/gpt-6-luna",
              "openai/gpt-5.6-luna",
              "openai/gpt-6-astra"
            ],
            "title": "Model Id"
          },
          "reasoning_efforts": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning Efforts"
          },
          "search_calls": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Search Calls"
          },
          "fetched_pages": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Fetched Pages"
          },
          "tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tokens"
          },
          "unknown_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Unknown Tokens"
          },
          "stop_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Reason"
          },
          "memory_status": {
            "type": "string",
            "enum": [
              "off",
              "read_only",
              "skipped",
              "pending",
              "applied",
              "degraded",
              "needs_reconciliation",
              "dead_letter"
            ],
            "title": "Memory Status"
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "known_cost_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Known Cost Usd"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_id",
          "search_calls",
          "fetched_pages",
          "tokens",
          "unknown_tokens",
          "stop_reason",
          "memory_status"
        ],
        "title": "ExecutionSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NarrativeAssertion": {
        "properties": {
          "statement_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Statement Id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Text"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "recommendation",
              "example"
            ],
            "title": "Kind"
          },
          "claim_ids": {
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": "array",
            "title": "Claim Ids"
          },
          "evidence_ids": {
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Anchor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "statement_id",
          "text",
          "kind",
          "claim_ids",
          "evidence_ids",
          "anchor"
        ],
        "title": "NarrativeAssertion"
      },
      "NarrativeDraft": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "enum": [
              2,
              3
            ],
            "title": "Schema Version",
            "default": 2
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Title"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/NarrativeSection"
            },
            "type": "array",
            "title": "Sections"
          },
          "limitations": {
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": "array",
            "title": "Limitations"
          },
          "unresolved_questions": {
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": "array",
            "title": "Unresolved Questions"
          },
          "coverage": {
            "items": {
              "$ref": "#/components/schemas/QuestionCoverage"
            },
            "type": "array",
            "title": "Coverage"
          },
          "paragraph_answers": {
            "additionalProperties": {
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Paragraph Answers"
          },
          "quality_status": {
            "type": "string",
            "enum": [
              "pending",
              "passed",
              "revised",
              "not_checked",
              "issues_remaining"
            ],
            "title": "Quality Status",
            "default": "pending"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "sections",
          "limitations",
          "unresolved_questions"
        ],
        "title": "NarrativeDraft"
      },
      "NarrativeParagraph": {
        "properties": {
          "block_type": {
            "type": "string",
            "enum": [
              "paragraph",
              "list",
              "table",
              "code"
            ],
            "title": "Block Type",
            "default": "paragraph"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Text"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "illustrative": {
            "type": "boolean",
            "title": "Illustrative",
            "default": false
          },
          "paragraph_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Paragraph Id"
          },
          "assertions": {
            "items": {
              "$ref": "#/components/schemas/NarrativeAssertion"
            },
            "type": "array",
            "minItems": 1,
            "title": "Assertions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "paragraph_id",
          "assertions"
        ],
        "title": "NarrativeParagraph"
      },
      "NarrativeSection": {
        "properties": {
          "heading": {
            "type": "string",
            "title": "Heading"
          },
          "paragraphs": {
            "items": {
              "$ref": "#/components/schemas/NarrativeParagraph"
            },
            "type": "array",
            "title": "Paragraphs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "heading",
          "paragraphs"
        ],
        "title": "NarrativeSection"
      },
      "QuestionCoverage": {
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Question"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "partial",
              "unresolved"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "required",
          "status"
        ],
        "title": "QuestionCoverage"
      },
      "Report": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "report_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Report Id"
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Run Id"
          },
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version",
            "default": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "partial"
            ],
            "title": "Status"
          },
          "markdown": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Markdown"
          },
          "structured": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReportDraft"
              },
              {
                "$ref": "#/components/schemas/NarrativeDraft"
              }
            ],
            "title": "Structured",
            "discriminator": {
              "propertyName": "schema_version",
              "mapping": {
                "1": "#/components/schemas/ReportDraft",
                "2": "#/components/schemas/NarrativeDraft",
                "3": "#/components/schemas/NarrativeDraft"
              }
            }
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "report_id",
          "run_id",
          "status",
          "markdown",
          "structured",
          "citations",
