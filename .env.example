# Required. Keep .env private; it is ignored by Git.
OPENROUTER_API_KEY=
API_BEARER_TOKEN=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-value

# A local folder containing Markdown, text, or text-based PDF files.
# Compose mounts this folder read-only.
VAULT_PATH=./example-vault

# Optional native-development overrides.
RA_DATABASE_URL=postgresql://research:research-local@127.0.0.1:55432/research
RA_SEARXNG_URL=http://127.0.0.1:8088
RA_LETTA_URL=http://127.0.0.1:8283
